    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
