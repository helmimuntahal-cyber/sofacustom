{
  "name": "sofacustom",
  "version": "0.1.0",
  "private": true,
  "description": "Website Sofa Custom (CV. Halim Cipta Kreasi) — jasa pembuatan sofa custom dan servis sofa.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
