# Salin file ini menjadi `.env.local` lalu isi nilainya.
# Semua variabel NEXT_PUBLIC_* ikut masuk ke HTML/JS publik — JANGAN isi dengan rahasia.

# Nomor WhatsApp bisnis, format internasional TANPA "+", spasi, atau tanda hubung.
# Contoh format (bukan nomor asli): 62xxxxxxxxxx
NEXT_PUBLIC_WHATSAPP_NUMBER=GANTI_DENGAN_NOMOR_BISNIS

# Domain produksi untuk canonical URL, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL=https://sofacustom.my.id

# Isi "false" untuk staging/preview agar robots.txt melarang pengindeksan.
NEXT_PUBLIC_ALLOW_INDEXING=true
